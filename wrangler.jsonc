{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hartford-311",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-26",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin", "/admin/*"],
    "not_found_handling": "404-page"
  },
  "d1_databases": [{"binding":"DB","database_name":"hartford-311","database_id":"00000000-0000-0000-0000-000000000000","migrations_dir":"worker/migrations"}],
  "r2_buckets": [{"binding":"PHOTOS","bucket_name":"hartford-311-private-photos"}],
  "durable_objects": {"bindings":[{"name":"RATE_GATE","class_name":"RateGate"}]},
  "migrations": [{"tag":"v1","new_sqlite_classes":["RateGate"]}],
  "images": {"binding":"IMAGES"},
  "triggers": {"crons":["*/5 * * * *"]},
  "limits": {"cpu_ms":1000},
  "observability": {"enabled":false},
  "vars": {"APP_ORIGIN":"https://311.example.invalid","ACCESS_TEAM_DOMAIN":"https://replace-me.cloudflareaccess.com","ACCESS_AUD":""}
}
